{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cou-hackathon",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "30d63e455590ff80b226afa8e9e33218",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cou-hackathon",
      "database_id": "befa4b62-7719-41d1-ac9f-943cae15f9f0",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "cou-hackathon-files" }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://cou-hackathon.cou-hackathon.workers.dev",
    "EMAIL_PROVIDER": "smtp",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465",
    "SMTP_USER": "coutechnova2026@gmail.com",
    "EMAIL_FROM": "CoU AI Hackathon 2026 <coutechnova2026@gmail.com>",
    "EMAIL_REPLY_TO": "coutechnova2026@gmail.com",
    "ADMIN_NOTIFY_EMAIL": "coutechnova2026@gmail.com",
    "EMAIL_BATCH_SIZE": "10"
  }
}
